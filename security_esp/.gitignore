firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/dependencies.lock
firmware/managed_components/

# Host test binaries
firmware/tests/host/build/

# Editor / OS
.DS_Store
Thumbs.db
*.swp
*.user

