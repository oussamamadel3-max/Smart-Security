*.pem
*.key
secrets/
.env
.env.*

# Optional: keep third_party sources local but allow lockfile
# third_party/Unity/ and third_party/cJSON/ are fetched by tools/fetch_host_deps.sh
# Uncomment the next two lines if you prefer NOT to commit vendored trees:
# third_party/Unity/
# third_party/cJSON/
!third_party/HOST_DEPS.lock
