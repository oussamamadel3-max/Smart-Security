# Development — example variable NAMES only. Copy values via User Secrets / local env.
# User SecretsId: esp32-security-backend-api
# Never commit real values. Never use production credentials here.

ASPNETCORE_ENVIRONMENT=Development

# Prefer OPS-T-01 Compose Postgres on 127.0.0.1:5433
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5433;Database=esp32_security_dev;Username=ss_dev;Password=USE_LOCAL_ONLY

# JWT — local development key (≥32 chars). Unique to Development; never reuse in staging/prod.
Auth__Jwt__Issuer=esp32-security-dev
Auth__Jwt__Audience=esp32-security-clients-dev
Auth__Jwt__SigningKey=REPLACE_WITH_LOCAL_DEV_KEY_MIN_32_CHARS________

Auth__Cookie__Name=esp32_rt_dev
Auth__Cookie__Path=/api/auth
Auth__Cookie__SameSite=Lax
Auth__CsrfCookieName=esp32_csrf_dev
Auth__CsrfHeaderName=X-CSRF-TOKEN

# CORS — local Flutter web / Vite style origins only
Auth__Cors__AllowedOrigins__0=https://localhost:5173
Auth__Cors__AllowedOrigins__1=http://localhost:5173

# MQTT / FCM remain disabled for production paths; local broker optional for ACL labs only
Mqtt__Inbound__Enabled=false
Mqtt__Outbound__LivePublishEnabled=false
Mqtt__Outbox__Enabled=false
Mqtt__Inbound__UseTls=false
Fcm__Enabled=false
Fcm__Provider=Fake
Fcm__TokenEncryptionKey=
