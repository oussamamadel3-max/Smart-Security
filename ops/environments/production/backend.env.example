# Production — TEMPLATE ONLY. PRODUCTION MQTT/OUTBOX/FCM REMAIN DISABLED.
# Do not activate LivePublish/Inbound/Outbox without explicit owner authorization after G1.
# Real values: secrets manager only. Never commit.

ASPNETCORE_ENVIRONMENT=Production

ConnectionStrings__DefaultConnection=Host=PROD_DB_HOST;Port=5432;Database=esp32_security_prod;Username=PROD_DB_USER;Password=USE_SECRETS_MANAGER

Auth__Jwt__Issuer=esp32-security-prod
Auth__Jwt__Audience=esp32-security-clients-prod
Auth__Jwt__SigningKey=USE_SECRETS_MANAGER_PROD_JWT_KEY_MIN_32

Auth__Cookie__Name=esp32_rt
Auth__Cookie__Path=/api/auth
Auth__Cookie__SameSite=None
Auth__CsrfCookieName=esp32_csrf
Auth__CsrfHeaderName=X-CSRF-TOKEN

Auth__Cors__AllowedOrigins__0=https://app.example.invalid

# Hard defaults — keep disabled until authorized
Mqtt__Inbound__Enabled=false
Mqtt__Outbound__LivePublishEnabled=false
Mqtt__Outbox__Enabled=false
Mqtt__Inbound__UseTls=true
Mqtt__Outbound__UseTls=true
Fcm__Enabled=false
Fcm__Provider=Fake
Fcm__FirebaseProjectId=PROD_FIREBASE_PROJECT_ID
Fcm__TokenEncryptionKey=USE_SECRETS_MANAGER
