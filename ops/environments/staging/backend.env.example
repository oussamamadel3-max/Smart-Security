# Staging — TEMPLATE ONLY. No live staging host is provisioned in OPS-T-02.
# Store real values in a secrets manager / host env — never in Git.

ASPNETCORE_ENVIRONMENT=Staging

ConnectionStrings__DefaultConnection=Host=STAGING_DB_HOST;Port=5432;Database=esp32_security_staging;Username=STAGING_DB_USER;Password=USE_SECRETS_MANAGER

Auth__Jwt__Issuer=esp32-security-staging
Auth__Jwt__Audience=esp32-security-clients-staging
Auth__Jwt__SigningKey=USE_SECRETS_MANAGER_STAGING_JWT_KEY_MIN_32

Auth__Cookie__Name=esp32_rt_stg
Auth__Cookie__Path=/api/auth
Auth__Cookie__SameSite=None
Auth__CsrfCookieName=esp32_csrf_stg
Auth__CsrfHeaderName=X-CSRF-TOKEN

# Replace with real staging web origins (HTTPS only)
Auth__Cors__AllowedOrigins__0=https://staging.example.invalid

# Staging may enable MQTT only after G1 + ops approval — default OFF in this template
Mqtt__Inbound__Enabled=false
Mqtt__Outbound__LivePublishEnabled=false
Mqtt__Outbox__Enabled=false
Mqtt__Inbound__UseTls=true
Mqtt__Outbound__UseTls=true
Fcm__Enabled=false
Fcm__Provider=Fake
Fcm__FirebaseProjectId=STAGING_FIREBASE_PROJECT_ID
Fcm__TokenEncryptionKey=USE_SECRETS_MANAGER
