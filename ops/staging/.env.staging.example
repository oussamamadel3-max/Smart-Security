# OPS-T-03 — staging-like LOCAL lab only. Copy to .env.staging (gitignored).
# Never use production secrets. Never publish ports beyond 127.0.0.1.
# MQTT production paths stay disabled.

COMPOSE_PROJECT_NAME=smartsecurity_stg

POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=esp32_security_staging
POSTGRES_USER=ss_stg
POSTGRES_PASSWORD=change-me-staging-local-only
POSTGRES_HOST_PORT=5434

MOSQUITTO_IMAGE=eclipse-mosquitto:2
MQTT_HOST_PORT=1884
MQTT_TLS_HOST_PORT=8884
MQTT_SRV_PASSWORD=change-me-stg-srv-local

# API is not published to the host by default (proxy-only). Keep for optional debug uncomment.
API_HOST_PORT=5080
PROXY_HTTPS_PORT=8443
PROXY_HTTP_PORT=8080

# Injected into API container at runtime (not baked into image)
ASPNETCORE_ENVIRONMENT=Staging
Auth__Jwt__Issuer=esp32-security-staging
Auth__Jwt__Audience=esp32-security-clients-staging
Auth__Jwt__SigningKey=REPLACE_STAGING_LOCAL_KEY_MIN_32_CHARS_____
Auth__Cors__AllowedOrigins__0=https://localhost:8443
Auth__Cookie__Name=esp32_rt_stg
Auth__Cookie__Path=/api/auth
Auth__Cookie__SameSite=None
Auth__CsrfCookieName=esp32_csrf_stg
Auth__CsrfHeaderName=X-CSRF-TOKEN

# Lab only: apply EF migrations on empty staging volume. Never point at Production.
Database__ApplyMigrationsOnStartup=true
# Trust Docker-private reverse proxy; requires API not host-published to untrusted clients.
ForwardedHeaders__TrustPrivateNetworkProxies=true

Mqtt__Inbound__Enabled=false
Mqtt__Outbound__LivePublishEnabled=false
Mqtt__Outbox__Enabled=false
Fcm__Enabled=false
Fcm__Provider=Fake

# Pin for rollback docs (replace with real image digest when publishing)
DEPLOY_IMAGE_TAG=local-stg
DEPLOY_GIT_SHA=UNSET
