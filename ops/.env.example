# OPS-T-01 — local development only. Copy to `.env` (gitignored) and change values.
# Never use production credentials. Never commit `.env`.

COMPOSE_PROJECT_NAME=smartsecurity

# PostgreSQL (host port 5433 avoids conflict with local postgres on 5432)
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=esp32_security_dev
POSTGRES_USER=ss_dev
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST_PORT=5433

# Mosquitto (plaintext 1883 + TLS 8883 bound to 127.0.0.1 only)
MOSQUITTO_IMAGE=eclipse-mosquitto:2
MQTT_HOST_PORT=1883
MQTT_TLS_HOST_PORT=8883

# Dev-only MQTT identities (passwords hashed into mosquitto/passwd by bootstrap)
MQTT_SRV_PASSWORD=change-me-srv-local
MQTT_DEVA_PASSWORD=change-me-deva-local
MQTT_DEVB_PASSWORD=change-me-devb-local

# Stable test device IDs (match ACL topics; not production hardware IDs)
DEVICE_A_ID=11111111-1111-4111-8111-111111111111
DEVICE_B_ID=22222222-2222-4222-8222-222222222222
