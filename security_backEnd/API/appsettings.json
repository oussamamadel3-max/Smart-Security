{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=esp32_security;Username=postgres"
  },
  "Mqtt": {
    "Inbound": {
      "Enabled": false,
      "Host": "localhost",
      "Port": 1883,
      "ClientId": "smart-security-backend-inbound",
      "StateTopicFilter": "devices/+/state",
      "AcksTopicFilter": "devices/+/acks",
      "EventsTopicFilter": "devices/+/events",
      "KeepAliveSeconds": 15,
      "SessionExpirySeconds": 3600,
      "UseTls": false,
      "CaCertificatePath": ""
    },
    "Outbound": {
      "LivePublishEnabled": false,
      "Host": "localhost",
      "Port": 1883,
      "ClientId": "smart-security-backend-outbound",
      "KeepAliveSeconds": 15,
      "UseTls": false,
      "CaCertificatePath": ""
    },
    "Outbox": {
      "Enabled": false,
      "PollIntervalMs": 1000,
      "BatchSize": 20,
      "RetryDelaySeconds": 5,
      "MaxAttempts": 10
    }
  },
  "Fcm": {
    "Enabled": false,
    "Provider": "Fake",
    "FirebaseProjectId": "",
    "PollIntervalMs": 2000,
    "BatchSize": 20,
    "RetryDelaySeconds": 30,
    "MaxAttempts": 8,
    "TokenEncryptionKey": ""
  },
  "Auth": {
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 7,
    "CsrfHeaderName": "X-CSRF-TOKEN",
    "CsrfCookieName": "esp32_csrf",
    "Jwt": {
      "Issuer": "esp32-security",
      "Audience": "esp32-security-clients",
      "SigningKey": ""
    },
    "Cookie": {
      "Name": "esp32_rt",
      "Path": "/api/auth",
      "SameSite": "Lax"
    },
    "Cors": {
      "AllowedOrigins": [ "https://localhost:5173", "http://localhost:5173" ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
