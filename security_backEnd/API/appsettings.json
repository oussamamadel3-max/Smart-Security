{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=esp32_security;Username=postgres"
  },
  "Auth": {
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 7,
    "CsrfHeaderName": "X-CSRF-TOKEN",
    "CsrfCookieName": "esp32_csrf",
    "Jwt": {
      "Issuer": "esp32-security",
      "Audience": "esp32-security-clients",
      "SigningKey": ""
    },
    "Cookie": {
      "Name": "esp32_rt",
      "Path": "/api/auth",
      "SameSite": "Lax"
    },
    "Cors": {
      "AllowedOrigins": [ "https://localhost:5173", "http://localhost:5173" ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
