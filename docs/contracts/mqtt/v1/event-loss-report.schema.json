{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-security.local/contracts/mqtt/v1/event-loss-report.schema.json",
  "title": "EVENT_LOSS_REPORT",
  "description": "AlarmEventIngestService.ParseEventLoss. reason is only BUFFER_FULL in the parser. clockTrusted defaults to false when omitted. Not a G1-adopted production contract.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "deviceId",
    "messageId",
    "messageType",
    "bootId",
    "reportUid",
    "ownershipVersion",
    "reason"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "deviceId": { "$ref": "#/$defs/uuid" },
    "messageId": { "$ref": "#/$defs/uuid" },
    "messageType": { "type": "string", "const": "EVENT_LOSS_REPORT" },
    "bootId": { "type": "string", "minLength": 1 },
    "reportUid": { "$ref": "#/$defs/uuid" },
    "ownershipVersion": { "type": "integer", "minimum": 0 },
    "reason": { "type": "string", "const": "BUFFER_FULL" },
    "lostCount": { "type": "integer", "minimum": 0 },
    "clockTrusted": { "type": "boolean" },
    "deviceOccurredAt": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    }
  }
}
